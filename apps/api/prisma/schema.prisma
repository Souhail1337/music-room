// Music Room — data model. Binding constraints come from the architecture spine (AD-6, AD-10).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  passwordHash    String?
  displayName     String
  emailVerifiedAt DateTime?
  googleSub       String?   @unique
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions   Session[]
  authTokens AuthToken[]
  actionLogs ActionLog[]

  @@map("users")
}

/// One row per issued refresh token. Rows created by rotating the same login share a familyId (AD-6).
model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  familyId   String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  rotatedAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
  @@map("sessions")
}

enum AuthTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

/// Single-use email tokens (verification 24h, reset 1h). Only the hash is stored.
model AuthToken {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @db.Uuid
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("auth_tokens")
}

/// One row per API request, written by the global logs middleware (AD-10).
model ActionLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @db.Uuid
  method     String
  route      String
  path       String
  status     Int
  platform   String?
  device     String?
  appVersion String?
  ip         String?
  durationMs Int
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("action_logs")
}
