# Music Room app config — copy to .env (git-ignored). Read by app.config.ts at build time.

# Initial API URL. 10.0.2.2 is the host machine as seen from the Android emulator;
# on a real phone use your machine's LAN IP, e.g. http://192.168.1.20:3000. Changeable in Settings.
DEFAULT_SERVER_URL=http://10.0.2.2:3000

# Google OAuth web client ID (same value as the API's GOOGLE_WEB_CLIENT_ID). Leave empty until configured.
GOOGLE_WEB_CLIENT_ID=
# Only for iOS builds: com.googleusercontent.apps.<id>
GOOGLE_IOS_URL_SCHEME=
