# Music Room — copy to .env (git-ignored) and adjust. Every backend setting is read from here (AD-11).

# --- API ---
API_PORT=3000
# Base URL used in links inside emails (verification / reset pages served by the API).
# Links are opened wherever the mail is read: localhost works from the host's Mailpit UI; to open them
# on a phone, use the host's LAN IP (e.g. http://192.168.1.20:3000).
API_PUBLIC_URL=http://localhost:3000

# --- Database (docker compose service "postgres") ---
POSTGRES_USER=musicroom
POSTGRES_PASSWORD=musicroom
POSTGRES_DB=musicroom
# Used by the API container (host "postgres") — compose overrides the host automatically.
DATABASE_URL=postgresql://musicroom:musicroom@localhost:5432/musicroom
# Separate database for the e2e tests (created automatically by the test setup).
TEST_DATABASE_URL=postgresql://musicroom:musicroom@localhost:5432/musicroom_test

# --- Auth (AD-6) ---
# Replace with a long random string: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-change-me-to-a-long-random-string
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# --- Rate limits (requests per minute) ---
THROTTLE_LIMIT=100
AUTH_THROTTLE_LIMIT=5

# --- Mail (docker compose service "mailpit"; web UI on http://localhost:8025) ---
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="Music Room <no-reply@musicroom.local>"

# --- Google sign-in (optional; leave empty until configured) ---
# Web client ID from Google Cloud console. The Android app requests ID tokens for this audience.
GOOGLE_WEB_CLIENT_ID=
