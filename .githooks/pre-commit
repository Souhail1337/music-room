#!/bin/sh
# Blocks commits that add secrets (NFR-8). Enable once per clone with `make hooks`.
# CI runs the same scan on every push, so skipping it locally only delays the failure.
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed (brew install gitleaks); secret scan skipped." >&2
  echo "pre-commit: CI will still scan this commit." >&2
  exit 0
fi
exec gitleaks git --pre-commit --staged --redact --no-banner --verbose
