# Music Room app config — copy to .env (git-ignored). Read by app.config.ts at build time.

# Initial API URL. Leave empty to use the machine running Metro on port 3000: its LAN IP on a phone
# (Expo Go or dev build on the same Wi-Fi), 10.0.2.2 on the emulator. Changeable in Settings → Server URL.
DEFAULT_SERVER_URL=

# Google OAuth web client ID (same value as the API's GOOGLE_WEB_CLIENT_ID). Leave empty until configured.
GOOGLE_WEB_CLIENT_ID=
# Only for iOS builds: com.googleusercontent.apps.<id>
GOOGLE_IOS_URL_SCHEME=
